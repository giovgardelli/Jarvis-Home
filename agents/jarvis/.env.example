# Jarvis central service — Telegram router + morning brief. Copy to agents/jarvis/.env
TELEGRAM_BOT_TOKEN=           # from @BotFather (your main "Jarvis" bot)
GIO_CHAT_ID=                  # chat id per household member: who gets which brief
KENZ_CHAT_ID=
# Optional: answer Telegram voice notes
# STT_ENABLED=false           # needs OPENAI_API_KEY (Whisper)
# OPENAI_API_KEY=
# TTS_ENABLED=false           # reply with voice notes (uses ELEVENLABS_* from ~/.jarvis_env)
# Shared settings (ANTHROPIC_API_KEY, JARVIS_SECRET, GEMINI_API_KEY, GOOGLE_*) come from ~/.jarvis_env
