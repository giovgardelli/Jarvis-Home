# Ray Mote — Nest thermostats. Copy to agents/ray_mote/.env
NEST_PROJECT_ID=              # Device Access project id (README.md, "Set up Nest access")
NEST_CLIENT_ID=               # OAuth client (Web application) linked to that project
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=           # printed by get_token.py
# NEST_ZONES=upstairs=Hallway, downstairs=Living Room   # only if the Nest names aren't what you say
# RAY_MOTE_MIN_F=68               # the lowest and highest temperature Ray will set
# RAY_MOTE_MAX_F=75
# Optional: Ray's own Telegram bot (Jarvis's bot reaches Ray without it)
# TELEGRAM_BOT_TOKEN=
# ALLOWED_CHAT_IDS=
# GIO_CHAT_ID=
# KENZ_CHAT_ID=
# ANTHROPIC_MODEL=                # this agent only; default is CLAUDE_MODEL in ~/.jarvis_env
# Shared settings (ANTHROPIC_API_KEY, JARVIS_SECRET) come from ~/.jarvis_env
