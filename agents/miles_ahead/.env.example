# Miles Ahead — Southwest fare-drop alerts. Copy to agents/miles_ahead/.env
TELEGRAM_BOT_TOKEN=           # from @BotFather
ALLOWED_CHAT_IDS=             # comma-separated Telegram chat ids allowed to use the bot
RECIPIENT_CHAT_ID=            # who receives fare-drop alerts
GOOGLE_SHEET_ID=              # the sheet with the Flights tab described in README.md
SERPAPI_KEY=                  # serpapi.com — Google Flights prices
# Shared settings (JARVIS_SECRET, GOOGLE_*) come from ~/.jarvis_env
