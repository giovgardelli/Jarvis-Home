# Drew Parture — flight alerts from your Google Calendar. Copy to agents/drew_parture/.env
TELEGRAM_BOT_TOKEN=           # from @BotFather
ALLOWED_CHAT_IDS=             # comma-separated Telegram chat ids allowed to use the bot
RECIPIENT_CHAT_ID=            # who receives the departure/landing alerts
GIO_CHAT_ID=
KENZ_CHAT_ID=
AVIATIONSTACK_API_KEY=        # aviationstack.com — live flight status
