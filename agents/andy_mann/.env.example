# Andy Mann — home maintenance. Copy to agents/andy_mann/.env
TELEGRAM_BOT_TOKEN=           # from @BotFather (one bot per agent)
ALLOWED_CHAT_IDS=             # comma-separated Telegram chat ids allowed to use the bot
GIO_CHAT_ID=                  # chat id per household member (names from household.json)
KENZ_CHAT_ID=
GOOGLE_SHEET_ID=              # the sheet with the tabs described in README.md
AIRNOW_API_KEY=               # optional: air-quality alerts (docs.airnowapi.org, US only)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Shared settings (ANTHROPIC_API_KEY, JARVIS_SECRET, GOOGLE_*) come from ~/.jarvis_env
